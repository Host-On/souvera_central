<?xml version="1.0"?>
<info xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="https://apps.nextcloud.com/schema/apps/info.xsd">
    <id>souvera_central</id>
    <name>Souvera Central</name>
    <summary>Modulare Management-Zentrale für Nextcloud</summary>
    <description><![CDATA[
        Souvera Central ist die zentrale modulare Management-Plattform für Nextcloud.

        Features:
        - Modulares Plugin-System
        - User Management mit Lizenz-Limits
        - Domain-Whitelist für E-Mails
        - Feature-Toggle für Module
        - Erweiterbar mit zusätzlichen Modulen

        Verfügbare Module:
        - User Management: Moderne Benutzerverwaltung mit Echtzeit-Validierung
        - Gruppen Management (coming soon)
        - Security & Audit (coming soon)
    ]]></description>
    <version>0.40.85</version>
    <licence>agpl</licence>
    <author>Souvera</author>
    <namespace>SouveraCentral</namespace>
    <category>organization</category>
    <bugs>https://github.com/Host-On/souvera_central/issues</bugs>

    <dependencies>
        <nextcloud min-version="30" max-version="34"/>
    </dependencies>

    <repair-steps>
        <pre-update>
            <!-- v0.40.27: `occ app:update souvera_central` pulls the
                 newest GitHub releases for all managed apps BEFORE the
                 migration machinery runs — no manual git pull needed. -->
            <step>OCA\SouveraCentral\Repair\SelfUpdateNowStep</step>
        </pre-update>
        <post-migration>
            <step>OCA\SouveraCentral\Repair\InstallBrandingTheme</step>
            <step>OCA\SouveraCentral\Repair\EnsureHelpGroupAccess</step>
        </post-migration>
    </repair-steps>
